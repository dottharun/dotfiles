#!/usr/bin/env bash

addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$PATH:$1
    fi
}

addToPathFront() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$1:$PATH
    fi
}

# to change keyboard repeat rate (X11 only, xset needs $DISPLAY)
if [ -n "${DISPLAY:-}" ] && command -v xset >/dev/null 2>&1; then
  xset r rate 300 100
fi
